# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:temp1234@localhost:5432/conciliacion?schema=public"

# JWT para sesiones (cambiar en producción)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Usuario gerencia inicial (lo crea el seed)
SEED_ADMIN_EMAIL="gerencia@moregiros.cl"
SEED_ADMIN_PASSWORD="cambia-esto"
SEED_ADMIN_NAME="Gerencia"

# Dynatech (sistema operacional de cajeros)
DYNATECH_API_URL="http://172.16.10.172:5158/api/dynatech"
DYNATECH_API_KEY=""
# Zona horaria asumida para fechas que vienen sin sufijo
DYNATECH_TIMEZONE_OFFSET="-04:00"

# Auth — cookie Secure exige HTTPS. Dejar false en deploys HTTP por VPN.
COOKIE_SECURE=false

# Tesoreria - apunta al endpoint unificado /api/dynatech.
# (El nombre TESORERIA_API_* es historico: corresponde al modulo
# "Movimientos 200" en la UI. La fuente real es /api/dynatech).
TESORERIA_API_URL="http://172.16.10.172:5158/api/dynatech"
TESORERIA_API_KEY=""
