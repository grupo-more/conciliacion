generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
}

model BankAccount {
  id            String   @id @default(uuid())
  bankCode      String   @map("bank_code")        // "BCI" | "SANTANDER" | "INTERNACIONAL"
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")   // normalizado (solo dígitos)
  displayNumber String?  @map("display_number")   // como lo muestra el banco
  holderName    String   @map("holder_name")
  holderRut     String?  @map("holder_rut")
  currency      String   @default("CLP") @db.Char(3)
  alias         String?
  purpose       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  imports     StatementImport[]
  movements   BankMovement[]
  branchHints BranchAccountHint[]
  aliases     BankAccountAlias[]

  @@unique([bankCode, accountNumber])
  @@index([active])
}

// Mapeo explícito de TesoreriaMovement.banco → BankAccount.
// El motor de Consolidados consulta esta tabla para resolver con certeza a qué
// cuenta corresponde cada movimiento de Tesorería. Es la pieza clave que
// reemplaza el fuzzy matching por bankCode (que confundía las múltiples
// cuentas Santander entre sí).
model BankAccountAlias {
  id          String      @id @default(uuid())
  // String exacto que viene en TesoreriaMovement.banco (ej. "Santander ME",
  // "BCI ME", "Santander BAGO"). Único.
  bancoString String      @unique @map("banco_string")
  accountId   String      @map("account_id")
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([accountId])
}

model StatementImport {
  id             String    @id @default(uuid())
  accountId      String    @map("account_id")
  account        BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parserCode     String    @map("parser_code")
  fileName       String    @map("file_name")
  fileHash       String    @map("file_hash")
  periodFrom     DateTime? @map("period_from")
  periodTo       DateTime? @map("period_to")
  rowsTotal      Int       @default(0) @map("rows_total")
  rowsInserted   Int       @default(0) @map("rows_inserted")
  rowsDuplicated Int       @default(0) @map("rows_duplicated")
  rowsFailed     Int       @default(0) @map("rows_failed")
  rawMetadata    Json?     @map("raw_metadata")
  createdAt      DateTime  @default(now()) @map("created_at")

  movements BankMovement[]

  @@unique([accountId, fileHash])
  @@index([accountId, createdAt])
}

model BankMovement {
  id                String   @id @default(uuid())
  accountId         String   @map("account_id")
  account           BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statementImportId String   @map("statement_import_id")
  statementImport   StatementImport @relation(fields: [statementImportId], references: [id], onDelete: Cascade)

  externalId        String?  @map("external_id")
  postDate          DateTime @map("post_date")
  transactionDate   DateTime? @map("transaction_date")
  amount            BigInt
  currency          String   @default("CLP") @db.Char(3)
  direction         String                              // "IN" | "OUT"
  description       String   @db.Text
  descriptionNorm   String   @map("description_norm") @db.Text
  balanceAfter      BigInt?  @map("balance_after")

  counterpartyName    String? @map("counterparty_name")
  counterpartyRut     String? @map("counterparty_rut")
  counterpartyAccount String? @map("counterparty_account")
  counterpartyBank    String? @map("counterparty_bank")

  branchLabel String? @map("branch_label")
  txType      String? @map("tx_type")

  dedupKey String @map("dedup_key")
  rawRow   Json   @map("raw_row")

  createdAt DateTime @default(now()) @map("created_at")

  reconciliationLinks ReconciliationLink[]
  consolidadoLinks    ConsolidadoLink[]

  @@unique([accountId, dedupKey])
  @@index([accountId, postDate])
  @@index([externalId])
}

model DynatechMovement {
  id                 String   @id @default(uuid())
  // ID externo de Dynatech (contexto.id en la API). Es la clave para dedup
  // entre syncs. El nombre de columna 'm_cj_id' es histórico (cuando se llamaba
  // mCjId); el contenido es el mismo identificador único.
  mCjId              BigInt   @unique @map("m_cj_id")

  branchExternalId   Int      @map("branch_external_id")
  branchExternalName String?  @map("branch_external_name")

  cashierUsername    String   @map("cashier_username")
  cashierName        String?  @map("cashier_name")

  documentCode       Int      @map("document_code")
  documentType       String?  @map("document_type")
  documentFolio      BigInt   @default(0) @map("document_folio")

  // Cliente identificado por el cajero. NULL cuando es CLIENTE GENERICO
  // (RUT 55555555-5 en la API Dynatech) o cuando el campo no viene en la respuesta.
  customerName       String?  @map("customer_name")
  customerRut        String?  @map("customer_rut")

  observation        String   @db.Text
  occurredAt         DateTime @map("occurred_at")
  loadedAt           DateTime? @map("loaded_at")

  totalAmount        BigInt   @map("total_amount")
  currency           String   @default("CLP") @db.Char(3)

  // Rubro contable de la sucursal (campo rubroSucursal de la API). El nombre
  // de columna 'rubro' es histórico; el contenido siempre fue el rubro de
  // sucursal.
  rubro              Int?

  // Rubro contable del banco asociado (rubroBanco en la API).
  rubroBank          Int?     @map("rubro_bank")

  // Banco asignado al movimiento (campo "banco" en la API, ej "Santander ME").
  bankName           String?  @map("bank_name")

  // Banco que la sucursal/cajero tenía configurado para este movimiento.
  branchBank         String?  @map("branch_bank")

  // Banco detectado heurísticamente por la API. Puede diferir de bankName
  // cuando hay excepciones (ej: el movimiento se hizo en una cuenta distinta
  // a la que debería corresponder a la sucursal).
  detectedBank       String?  @map("detected_bank")

  // Flag de excepción: el movimiento no cumple alguna regla y requiere revisión.
  isException        Boolean  @default(false) @map("is_exception")

  items              Json
  rawJson            Json     @map("raw_json")

  syncedAt           DateTime @default(now()) @map("synced_at")

  reconciliation Reconciliation?

  @@index([branchExternalId])
  @@index([cashierUsername])
  @@index([occurredAt])
  @@index([documentCode])
  @@index([documentFolio])
  @@index([customerRut])
  @@index([rubro])
  @@index([rubroBank])
  @@index([isException])
}

model DynatechSyncRun {
  id                String   @id @default(uuid())
  startedAt         DateTime @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  status            String                              // RUNNING | OK | ERROR
  fetchedRows       Int      @default(0) @map("fetched_rows")
  insertedRows      Int      @default(0) @map("inserted_rows")
  skippedDuplicates Int      @default(0) @map("skipped_duplicates")
  skippedInvalid    Int      @default(0) @map("skipped_invalid")
  errorMessage      String?  @db.Text @map("error_message")
  fetchMs           Int?     @map("fetch_ms")

  @@index([startedAt])
  @@index([status, startedAt])
}

// Movimiento de Tesoreria - viene del endpoint /api/banco/conciliacion.
// Este feed es distinto al de Dynatech: ya viene clasificado por banco
// detectado vs banco asignado a la sucursal, con flag de excepcion. Lo
// usamos para reportes de mapeo rubroSucursal -> rubroBanco.
model TesoreriaMovement {
  id                 String   @id @default(uuid())
  externalId         BigInt   @unique @map("external_id")

  sucursalId         Int      @map("sucursal_id")
  sucursalName       String?  @map("sucursal_name")

  cajeroUsername     String   @map("cajero_username")
  cajeroName         String?  @map("cajero_name")

  clienteName        String?  @map("cliente_name")
  clienteRut         String?  @map("cliente_rut")

  folio              BigInt   @default(0)
  tipoDocumento      String?  @map("tipo_documento")
  codigoDocumento    Int      @default(0) @map("codigo_documento")

  glosa              String   @db.Text
  banco              String?
  bancoSucursal      String?  @map("banco_sucursal")
  bancoDetectado     String?  @map("banco_detectado")

  rubroBanco         Int?     @map("rubro_banco")
  rubroSucursal      Int?     @map("rubro_sucursal")

  monto              BigInt
  fecha              DateTime
  fechaCarga         DateTime? @map("fecha_carga")

  esExcepcion        Boolean  @default(false) @map("es_excepcion")

  items              Json
  rawJson            Json     @map("raw_json")

  syncedAt           DateTime @default(now()) @map("synced_at")

  consolidado Consolidado?

  @@index([sucursalId])
  @@index([cajeroUsername])
  @@index([fecha])
  @@index([banco])
  @@index([rubroBanco])
  @@index([rubroSucursal])
  @@index([esExcepcion])
}

model TesoreriaSyncRun {
  id                String   @id @default(uuid())
  startedAt         DateTime @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  status            String                              // RUNNING | OK | ERROR
  fetchedRows       Int      @default(0) @map("fetched_rows")
  insertedRows      Int      @default(0) @map("inserted_rows")
  updatedRows       Int      @default(0) @map("updated_rows")
  skippedDuplicates Int      @default(0) @map("skipped_duplicates")
  skippedInvalid    Int      @default(0) @map("skipped_invalid")
  errorMessage      String?  @db.Text @map("error_message")
  fetchMs           Int?     @map("fetch_ms")

  @@index([startedAt])
  @@index([status, startedAt])
}

// Etiqueta humana para los codigos de rubro de Dynatech.
// El codigo (ej. 200 = Tesoreria) viene en cada movimiento desde la API.
// Aqui le damos nombre + descripcion para mostrarlo en la UI. Los rubros
// se crean manualmente; si llega un movimiento con un rubro sin label,
// el front lo muestra solo como numero.
model RubroLabel {
  rubro       Int      @id
  name        String
  description String?  @db.Text
  // Marca si este rubro se puede usar como destino de la diferencia en un
  // match manual con ajuste (ej. "Excedentes", "Faltantes"). Solo los rubros
  // con isDifference=true aparecen en el select del form de ajuste, para
  // evitar elegir por error un rubro de banco/sucursal.
  isDifference Boolean @default(false) @map("is_difference")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

// Hint opcional: sucursal Dynatech → cuenta bancaria preferida.
// Se usa como pista cuando el mCjObs no menciona banco/empresa explícitamente.
// El mCjObs explícito SIEMPRE gana sobre el hint manual.
// Si no hay hint, el matching infiere por historial (≥70% confianza) o queda en REVIEW.
model BranchAccountHint {
  id                String      @id @default(uuid())
  branchExternalId  Int         @unique @map("branch_external_id")
  branchName        String?     @map("branch_name")
  accountId         String      @map("account_id")
  account           BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notes             String?     @db.Text
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([branchExternalId])
  @@index([accountId])
}

// Conciliación: relaciona un movimiento de Dynatech con su contraparte bancaria.
// Una fila por DynatechMovement procesado. Los bank movements asociados van en
// ReconciliationLink (puede ser 0, 1 o N — soporta pagos divididos 1:N).
model Reconciliation {
  id                 String           @id @default(uuid())
  dynatechMovementId String           @unique @map("dynatech_movement_id")
  dynatechMovement   DynatechMovement @relation(fields: [dynatechMovementId], references: [id], onDelete: Cascade)

  // AUTO_MATCHED  → match automático con alta certeza (1:1 mismo día o 1:N con RUT común)
  // SUGGESTED     → match propuesto, requiere aprobación humana
  // REVIEW        → varios candidatos / múltiples combinaciones posibles, usuario elige
  // MANUAL        → match elegido manualmente por el usuario
  // NO_MATCH      → sin candidatos en la ventana; se reintenta al subir cartolas nuevas
  // OUT_OF_SCOPE  → mCjObs menciona banco no registrado (BICE, ITAU, CHILE, etc.)
  status String

  // EXACT_SAME_DAY | EXACT_PM2 | EXACT_PM7 | SPLIT_SAME_RUT | SPLIT | MANUAL | null
  matchType String? @map("match_type")

  // Por qué fue OUT_OF_SCOPE / NO_MATCH (texto libre o "Banco no registrado: BICE")
  outOfScopeReason String? @db.Text @map("out_of_scope_reason")

  notes String? @db.Text

  matchedAt DateTime @default(now()) @map("matched_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links ReconciliationLink[]

  @@index([status])
}

// Cada bank movement asociado a una conciliación. Soporta:
//   · 1:1 — un solo link
//   · 1:N — varios links (pago dividido en múltiples transferencias)
//   · 1:0 — sin links (NO_MATCH / OUT_OF_SCOPE)
model ReconciliationLink {
  id                String         @id @default(uuid())
  reconciliationId  String         @map("reconciliation_id")
  reconciliation    Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankMovementId    String         @map("bank_movement_id")
  bankMovement      BankMovement   @relation(fields: [bankMovementId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now()) @map("created_at")

  @@unique([reconciliationId, bankMovementId])
  @@unique([bankMovementId])  // un bank movement no puede estar en 2 conciliaciones
  @@index([reconciliationId])
}

// Consolidado: relaciona un movimiento de Tesoreria con su contraparte bancaria.
// Es el módulo sucesor de Reconciliation (que opera sobre Dynatech). Tesoreria
// trae el campo `banco` resuelto desde la API, así que el matching es directo
// (no requiere heurísticas de detección de banco como sí necesita Dynatech).
//
// Una fila por TesoreriaMovement procesado. Los BankMovement asociados van
// en ConsolidadoLink (0, 1 o N — soporta pagos divididos 1:N).
model Consolidado {
  id                   String            @id @default(uuid())
  tesoreriaMovementId  String            @unique @map("tesoreria_movement_id")
  tesoreriaMovement    TesoreriaMovement @relation(fields: [tesoreriaMovementId], references: [id], onDelete: Cascade)

  // AUTO_MATCHED  → match automático con alta certeza
  // SUGGESTED     → match propuesto, requiere aprobación humana
  // REVIEW        → múltiples candidatos o esExcepcion=true, usuario elige
  // MANUAL        → match elegido manualmente por el usuario
  // NO_MATCH      → sin candidatos en la ventana; se reintenta al subir cartolas nuevas
  // OUT_OF_SCOPE  → no se pudo identificar la cuenta bancaria desde el campo banco
  status String

  // EXACT_SAME_DAY | EXACT_PM3 | SPLIT_SAME_RUT | SPLIT | MANUAL | null
  matchType String? @map("match_type")

  // Score combinado (0-100) si aplica. Útil para auditoría.
  score Int?

  // Cuenta bancaria resuelta desde TesoreriaMovement.banco. Snapshot del
  // matching para evitar re-resolver si cambia el catálogo de cuentas.
  resolvedAccountId String?     @map("resolved_account_id")

  // Ajuste por diferencia entre el monto del banco y el de Tesorería.
  // Se llena solo cuando el operador cierra un match MANUAL con diferencia:
  // p.ej. Tesorería dice $949.806 y la transferencia bancaria fue $950.000
  // → adjustmentAmount = 194, adjustmentRubro = código del rubro contable
  // donde la diferencia debe ir (ej. "Excedentes"). En el asiento OK eso
  // genera una 3ra fila que cuadra el debe/haber.
  // adjustmentAmount es siempre POSITIVO (magnitud); el lado debe/haber lo
  // calcula el endpoint OK a partir de la dirección y signo de la diferencia.
  adjustmentAmount BigInt? @map("adjustment_amount")
  adjustmentRubro  Int?    @map("adjustment_rubro")
  adjustmentNote   String? @db.Text @map("adjustment_note")

  // Override del rubro banco para este Consolidado puntual. Solo se usa en
  // matches MANUAL cuando el operador elige explícitamente un rubro distinto
  // al accountingRubro de la cuenta. Si es null, el endpoint OK cae a la
  // cascada normal (account.accountingRubro → tm.rubroBanco).
  overrideRubroBanco Int? @map("override_rubro_banco")

  outOfScopeReason String? @db.Text @map("out_of_scope_reason")
  notes            String? @db.Text

  matchedAt DateTime @default(now()) @map("matched_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links ConsolidadoLink[]

  @@index([status])
  @@index([resolvedAccountId])
}

// Cada BankMovement asociado a un Consolidado. Mismo patrón que
// ReconciliationLink, pero independiente para que un BankMovement pueda
// estar conciliado en ambos sistemas si el histórico de Dynatech lo requiere.
//
// Nota: a futuro, si Dynatech se descontinúa definitivamente, conviene migrar
// los datos viejos de Reconciliation a Consolidado o borrarlos.
model ConsolidadoLink {
  id              String       @id @default(uuid())
  consolidadoId   String       @map("consolidado_id")
  consolidado     Consolidado  @relation(fields: [consolidadoId], references: [id], onDelete: Cascade)
  bankMovementId  String       @map("bank_movement_id")
  bankMovement    BankMovement @relation(fields: [bankMovementId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now()) @map("created_at")

  @@unique([consolidadoId, bankMovementId])
  @@unique([bankMovementId])  // un bank movement no puede estar en 2 consolidados
  @@index([consolidadoId])
}
