generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
}

model BankAccount {
  id            String   @id @default(uuid())
  bankCode      String   @map("bank_code")        // "BCI" | "SANTANDER" | "INTERNACIONAL"
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")   // normalizado (solo dígitos)
  displayNumber String?  @map("display_number")   // como lo muestra el banco
  holderName    String   @map("holder_name")
  holderRut     String?  @map("holder_rut")
  currency      String   @default("CLP") @db.Char(3)
  alias         String?
  purpose       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  imports     StatementImport[]
  movements   BankMovement[]
  aliases     BankAccountAlias[]

  @@unique([bankCode, accountNumber])
  @@index([active])
}

// Mapeo explícito de TesoreriaMovement.banco → BankAccount.
// El motor de Consolidados consulta esta tabla para resolver con certeza a qué
// cuenta corresponde cada movimiento de Tesorería. Es la pieza clave que
// reemplaza el fuzzy matching por bankCode (que confundía las múltiples
// cuentas Santander entre sí).
model BankAccountAlias {
  id          String      @id @default(uuid())
  // String exacto que viene en TesoreriaMovement.banco (ej. "Santander ME",
  // "BCI ME", "Santander BAGO"). Único.
  bancoString String      @unique @map("banco_string")
  accountId   String      @map("account_id")
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notes       String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([accountId])
}

model StatementImport {
  id             String    @id @default(uuid())
  accountId      String    @map("account_id")
  account        BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parserCode     String    @map("parser_code")
  fileName       String    @map("file_name")
  fileHash       String    @map("file_hash")
  periodFrom     DateTime? @map("period_from")
  periodTo       DateTime? @map("period_to")
  rowsTotal      Int       @default(0) @map("rows_total")
  rowsInserted   Int       @default(0) @map("rows_inserted")
  rowsDuplicated Int       @default(0) @map("rows_duplicated")
  rowsFailed     Int       @default(0) @map("rows_failed")
  rawMetadata    Json?     @map("raw_metadata")
  createdAt      DateTime  @default(now()) @map("created_at")

  movements BankMovement[]

  @@unique([accountId, fileHash])
  @@index([accountId, createdAt])
}

model BankMovement {
  id                String   @id @default(uuid())
  accountId         String   @map("account_id")
  account           BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statementImportId String   @map("statement_import_id")
  statementImport   StatementImport @relation(fields: [statementImportId], references: [id], onDelete: Cascade)

  externalId        String?  @map("external_id")
  postDate          DateTime @map("post_date")
  transactionDate   DateTime? @map("transaction_date")
  amount            BigInt
  currency          String   @default("CLP") @db.Char(3)
  direction         String                              // "IN" | "OUT"
  description       String   @db.Text
  descriptionNorm   String   @map("description_norm") @db.Text
  balanceAfter      BigInt?  @map("balance_after")

  counterpartyName    String? @map("counterparty_name")
  counterpartyRut     String? @map("counterparty_rut")
  counterpartyAccount String? @map("counterparty_account")
  counterpartyBank    String? @map("counterparty_bank")

  branchLabel String? @map("branch_label")
  txType      String? @map("tx_type")

  dedupKey String @map("dedup_key")
  rawRow   Json   @map("raw_row")

  createdAt DateTime @default(now()) @map("created_at")

  consolidadoLinks    ConsolidadoLink[]
  egresoConciliacionLinks EgresoConciliacionLink[]
  asientoManual       AsientoManual?

  @@unique([accountId, dedupKey])
  @@index([accountId, postDate])
  @@index([externalId])
}

// Movimiento de Tesoreria - viene del endpoint /api/banco/conciliacion.
// Este feed es distinto al de Dynatech: ya viene clasificado por banco
// detectado vs banco asignado a la sucursal, con flag de excepcion. Lo
// usamos para reportes de mapeo rubroSucursal -> rubroBanco.
model TesoreriaMovement {
  id                 String   @id @default(uuid())
  externalId         BigInt   @unique @map("external_id")

  sucursalId         Int      @map("sucursal_id")
  sucursalName       String?  @map("sucursal_name")

  cajeroUsername     String   @map("cajero_username")
  cajeroName         String?  @map("cajero_name")

  clienteName        String?  @map("cliente_name")
  clienteRut         String?  @map("cliente_rut")

  folio              BigInt   @default(0)
  tipoDocumento      String?  @map("tipo_documento")
  codigoDocumento    Int      @default(0) @map("codigo_documento")

  glosa              String   @db.Text
  banco              String?
  bancoSucursal      String?  @map("banco_sucursal")
  bancoDetectado     String?  @map("banco_detectado")

  rubroBanco         Int?     @map("rubro_banco")
  rubroSucursal      Int?     @map("rubro_sucursal")

  monto              BigInt
  // INGRESO | EGRESO = DIRECCIÓN del movimiento. Desde jun-2026 la API la manda
  // en `naturalezaOperacion` (antes en `tipoOperacion`). Si no viene, se deriva
  // del signo del monto. Discrimina contra qué lado de la cartola se concilia:
  // INGRESO -> IN, EGRESO -> OUT.
  tipoOperacion      String   @default("INGRESO") @map("tipo_operacion")
  // Clase de operación que manda la API en `tipoOperacion`: TBK | INGRESO |
  // EGRESO | CRYPTOMKT_INGRESO | CRYPTOMKT_RETIRO. Los "TBK" NO se descartan: la
  // etiqueta de la API no garantiza que sean el mismo registro que llega por
  // TbkTesoreria, así que se guardan como un movimiento más.
  claseOperacion     String?  @map("clase_operacion")
  fecha              DateTime
  fechaCarga         DateTime? @map("fecha_carga")

  esExcepcion        Boolean  @default(false) @map("es_excepcion")

  // Estado del documento en origen (contexto.estado de la API). CAJ = cajeado
  // (valido), ANU = anulado. `anulado`=true marca la transicion CAJ->ANU (se
  // anulo despues de existir como valido); un doc que nace ANU trae
  // anulado=false. Los anulados (estadoActual="ANU") se excluyen del motor y de
  // las vistas de "sin conciliar".
  estadoOriginal     String?  @map("estado_original")
  estadoActual       String?  @map("estado_actual")
  anulado            Boolean  @default(false)

  items              Json
  rawJson            Json     @map("raw_json")

  syncedAt           DateTime @default(now()) @map("synced_at")

  consolidado Consolidado?

  @@index([sucursalId])
  @@index([cajeroUsername])
  @@index([fecha])
  @@index([banco])
  @@index([rubroBanco])
  @@index([rubroSucursal])
  @@index([esExcepcion])
  @@index([tipoOperacion])
  @@index([estadoActual])
}

model TesoreriaSyncRun {
  id                String   @id @default(uuid())
  startedAt         DateTime @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  status            String                              // RUNNING | OK | ERROR
  fetchedRows       Int      @default(0) @map("fetched_rows")
  insertedRows      Int      @default(0) @map("inserted_rows")
  updatedRows       Int      @default(0) @map("updated_rows")
  skippedDuplicates Int      @default(0) @map("skipped_duplicates")
  skippedInvalid    Int      @default(0) @map("skipped_invalid")
  errorMessage      String?  @db.Text @map("error_message")
  fetchMs           Int?     @map("fetch_ms")

  @@index([startedAt])
  @@index([status, startedAt])
}

// Etiqueta humana para los codigos de rubro de Dynatech.
// El codigo (ej. 200 = Tesoreria) viene en cada movimiento desde la API.
// Aqui le damos nombre + descripcion para mostrarlo en la UI. Los rubros
// se crean manualmente; si llega un movimiento con un rubro sin label,
// el front lo muestra solo como numero.
model RubroLabel {
  rubro       Int      @id
  name        String
  description String?  @db.Text
  // Marca si este rubro se puede usar como destino de la diferencia en un
  // match manual con ajuste (ej. "Excedentes", "Faltantes"). Solo los rubros
  // con isDifference=true aparecen en el select del form de ajuste, para
  // evitar elegir por error un rubro de banco/sucursal.
  isDifference Boolean @default(false) @map("is_difference")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entidadesInternas EntidadInterna[]
}

// Entidad considerada "interna" para la deteccion de egresos a cuentas propias
// en cartolas bancarias. La idea: la cartola a veces trae counterpartyRut, a
// veces solo counterpartyName, a veces ninguno. Esta tabla concentra:
//   - RUT canonico (normalizado: solo digitos + K, sin puntos ni guion).
//   - Nombre canonico.
//   - aliases: las variantes de nombre que efectivamente aparecen en la cartola
//     (ej. "Internet a 76.815.928-9", "MORE CAPITAL S", "More Capital Spa").
//     El detector matchea por palabra entera contra cada alias cuando no hay RUT.
//   - rubroId opcional: enlace al rubro contable propio de la entidad (cuando
//     existe — ej. 198 para MG, 197 para ME). Puede quedar null para entidades
//     internas que no tienen rubro asignado.
model EntidadInterna {
  id              String   @id @default(uuid())
  rutCanonico     String   @unique @map("rut_canonico")
  nombreCanonico  String   @map("nombre_canonico")
  aliases         String[] @default([])
  rubro           Int?
  rubroLabel      RubroLabel? @relation(fields: [rubro], references: [rubro], onDelete: SetNull)
  notas           String?  @db.Text
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([active])
}

// Consolidado: relaciona un movimiento de Tesoreria con su contraparte bancaria.
// Tesoreria trae el campo `banco` resuelto desde la API, así que el matching
// es directo (no requiere heurísticas de detección de banco).
//
// Una fila por TesoreriaMovement procesado. Los BankMovement asociados van
// en ConsolidadoLink (0, 1 o N — soporta pagos divididos 1:N).
model Consolidado {
  id                   String            @id @default(uuid())
  tesoreriaMovementId  String            @unique @map("tesoreria_movement_id")
  tesoreriaMovement    TesoreriaMovement @relation(fields: [tesoreriaMovementId], references: [id], onDelete: Cascade)

  // AUTO_MATCHED  → match automático con alta certeza
  // SUGGESTED     → match propuesto, requiere aprobación humana
  // REVIEW        → múltiples candidatos o esExcepcion=true, usuario elige
  // MANUAL        → match elegido manualmente por el usuario
  // NO_MATCH      → sin candidatos en la ventana; se reintenta al subir cartolas nuevas
  // OUT_OF_SCOPE  → no se pudo identificar la cuenta bancaria desde el campo banco
  // ANULADO       → el movimiento de tesorería está anulado en origen (estadoActual="ANU"); fuera de conciliación
  status String

  // EXACT_SAME_DAY | EXACT_PM3 | SPLIT_SAME_RUT | SPLIT | MANUAL | null
  matchType String? @map("match_type")

  // Score combinado (0-100) si aplica. Útil para auditoría.
  score Int?

  // Cuenta bancaria resuelta desde TesoreriaMovement.banco. Snapshot del
  // matching para evitar re-resolver si cambia el catálogo de cuentas.
  resolvedAccountId String?     @map("resolved_account_id")

  // Ajuste por diferencia entre el monto del banco y el de Tesorería.
  // Se llena solo cuando el operador cierra un match MANUAL con diferencia:
  // p.ej. Tesorería dice $949.806 y la transferencia bancaria fue $950.000
  // → adjustmentAmount = 194, adjustmentRubro = código del rubro contable
  // donde la diferencia debe ir (ej. "Excedentes"). En el asiento OK eso
  // genera una 3ra fila que cuadra el debe/haber.
  // adjustmentAmount es siempre POSITIVO (magnitud); el lado debe/haber lo
  // calcula el endpoint OK a partir de la dirección y signo de la diferencia.
  adjustmentAmount BigInt? @map("adjustment_amount")
  adjustmentRubro  Int?    @map("adjustment_rubro")
  adjustmentNote   String? @db.Text @map("adjustment_note")

  // Override del rubro banco para este Consolidado puntual. Solo se usa en
  // matches MANUAL cuando el operador elige explícitamente un rubro distinto
  // al accountingRubro de la cuenta. Si es null, el endpoint OK cae a la
  // cascada normal (account.accountingRubro → tm.rubroBanco).
  overrideRubroBanco Int? @map("override_rubro_banco")

  outOfScopeReason String? @db.Text @map("out_of_scope_reason")
  notes            String? @db.Text

  // Candidato(s) que el motor PROPUSO para este match pero NO vinculó
  // (SUGGESTED / REVIEW con candidato). Persistimos los bankMovementId que
  // dieron el score, para mostrar SIEMPRE "contra qué apunta" en el detalle
  // (incluye splits), sin depender de un recálculo en vivo. Forma:
  // { "bankMovementIds": ["..."] }. Null para AUTO (que sí tiene links) y
  // para REVIEW sin candidato (excepción/multipart).
  proposalJson     Json?   @map("proposal_json")

  matchedAt DateTime @default(now()) @map("matched_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links ConsolidadoLink[]

  @@index([status])
  @@index([resolvedAccountId])
}

// Cada BankMovement asociado a un Consolidado.
//
// amountAllocated: porción del BankMovement.amount que este Consolidado
// consume. Habilita el split inverso (1 cartola → N tesorerías): el mismo
// BankMovement puede aparecer en N links, cada uno con su allocation. La
// suma de allocations de un BM no puede exceder su amount (validado en
// código en /api/consolidados/manual-link). null = "allocation completa"
// para compatibilidad con links históricos (1:1 o M-bancos:1-tesorería),
// donde el match consume todo el monto del BM.
model ConsolidadoLink {
  id              String       @id @default(uuid())
  consolidadoId   String       @map("consolidado_id")
  consolidado     Consolidado  @relation(fields: [consolidadoId], references: [id], onDelete: Cascade)
  bankMovementId  String       @map("bank_movement_id")
  bankMovement    BankMovement @relation(fields: [bankMovementId], references: [id], onDelete: Cascade)
  amountAllocated BigInt?      @map("amount_allocated")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@unique([consolidadoId, bankMovementId])
  @@index([consolidadoId])
  @@index([bankMovementId])
}

// Setting global del módulo "Dif menor a 100": detecta abonos IN bajo un
// umbral (transferencias chicas de "prueba" antes de la real) y los manda
// contra un rubro de diferencia, para no ensuciar la conciliación.
// Tabla con un único row (id = "default") editable desde Configuración.
model DifMenorSettings {
  id              String   @id @default("default")
  threshold       Int      @default(100)  // CLP, inclusivo (<= threshold)
  rubroDiferencia Int      @default(2050) @map("rubro_diferencia")
  updatedAt       DateTime @updatedAt @map("updated_at")
}

// ============================ Transbank ============================
//
// Dos fuentes nuevas que se cuadran entre si en la tab "Cruce Transbank":
//   - TransbankSale: detalle de liquidacion de Transbank (archivo "Abonos por
//     dia" .xls). Cada fila es una venta con tarjeta: bruto, comision, neto.
//   - TbkTesoreria: registro POS de la venta TBK (feed /api/tbk-tesoreria).
//
// NINGUNA de las dos entra al motor de Consolidados (ingresos/egresos): viven
// aparte para no generar ruido. El cruce es POS <-> settlement por
// sucursal + N° de boleta (= N° de OP de la glosa POS), con fallback a
// sucursal + monto bruto + fecha.

// Registro de cada import del archivo .xls de Transbank (mirror de StatementImport).
model TransbankImport {
  id           String   @id @default(uuid())
  fileName     String   @map("file_name")
  fileHash     String   @unique @map("file_hash")
  empresaRut   String?  @map("empresa_rut")
  cuentaAbono  String?  @map("cuenta_abono")
  periodFrom   DateTime? @map("period_from")
  periodTo     DateTime? @map("period_to")
  rowsTotal    Int      @default(0) @map("rows_total")
  rowsInserted Int      @default(0) @map("rows_inserted")
  rowsDuplicated Int    @default(0) @map("rows_duplicated")
  createdAt    DateTime @default(now()) @map("created_at")

  sales TransbankSale[]

  @@index([createdAt])
}

// Una venta con tarjeta liquidada por Transbank (lado banco/abono).
model TransbankSale {
  id              String   @id @default(uuid())
  importId        String   @map("import_id")
  import          TransbankImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  fechaVenta      DateTime @map("fecha_venta")
  tipoMovimiento  String   @map("tipo_movimiento")          // "Venta" | anulacion...
  codigoComercio  String   @map("codigo_comercio")
  nombreLocal     String   @map("nombre_local")
  sucursalId      Int?     @map("sucursal_id")               // resuelto desde nombreLocal
  medioPago       String   @map("medio_pago")                // Débito/Crédito/Prepago

  montoVenta      BigInt   @map("monto_venta")               // bruto (monto original de venta)
  comision        BigInt   @default(0)
  ivaComision     BigInt   @default(0) @map("iva_comision")
  totalAbono      BigInt   @map("total_abono")               // neto que llega al banco

  fechaAnulacion  DateTime? @map("fecha_anulacion")
  montoAnulado    BigInt   @default(0) @map("monto_anulado")

  numeroUnico     String   @unique @map("numero_unico")      // dedup natural (Transbank)
  tid             String?
  codigoAutorizacion String? @map("codigo_autorizacion")
  numeroBoleta    String?  @map("numero_boleta")             // = N° de OP del POS

  rawRow          Json     @map("raw_row")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([sucursalId, fechaVenta])
  @@index([numeroBoleta])
  @@index([montoVenta])
}

// Registro POS de una venta con tarjeta (feed /api/tbk-tesoreria). Mismo
// shape que Dynatech pero aislado: tipo "TBK", rubro 17. NO se concilia
// contra cartola en el motor de ingresos.
model TbkTesoreria {
  id             String   @id @default(uuid())
  externalId     BigInt   @unique @map("external_id")        // contexto.id

  sucursalId     Int      @map("sucursal_id")
  sucursalName   String?  @map("sucursal_name")
  cajeroUsername String?  @map("cajero_username")
  cajeroName     String?  @map("cajero_name")

  glosa          String   @db.Text
  opNumber       String?  @map("op_number")                  // extraido de la glosa
  fecha          DateTime
  monto          BigInt                                       // bruto
  folio          BigInt   @default(0)
  rubro          Int?
  tipo           String   @default("TBK")
  clienteName    String?  @map("cliente_name")
  clienteRut     String?  @map("cliente_rut")

  // Comisión que trae el feed por operación (objeto `comision`). El `monto`
  // viene CON IVA (es la comisión tal como la registra Dynatech). Es la fuente
  // del rubro 708 en la cuadratura. Débito suele venir null (= sin comisión).
  comisionMonto      BigInt?  @map("comision_monto")
  comisionPorcentaje Decimal? @map("comision_porcentaje") @db.Decimal(7, 4)
  comisionId         BigInt?  @map("comision_id")
  comisionGlosa      String?  @map("comision_glosa") @db.Text
  comisionFecha      DateTime? @map("comision_fecha")

  // Estado del documento en origen (contexto.estado). Ver TesoreriaMovement.
  // Los anulados (estadoActual="ANU") se excluyen del cruce Transbank.
  estadoOriginal String?  @map("estado_original")
  estadoActual   String?  @map("estado_actual")
  anulado        Boolean  @default(false)

  fechaCarga     DateTime? @map("fecha_carga")
  rawJson        Json     @map("raw_json")
  syncedAt       DateTime @default(now()) @map("synced_at")

  // POS FICTICIO: insertado a mano (no viene de la API) para vincular un abono
  // Transbank sin POS (ej. venta pagada parte tarjeta + parte efectivo que la
  // API no registró). externalId queda NEGATIVO (la API manda positivos, así el
  // sync nunca lo pisa). manual=true permite badgearlo y excluirlo de los
  // totales de "ventas POS reales".
  manual         Boolean  @default(false)
  manualNota     String?  @map("manual_nota") @db.Text
  createdById    String?  @map("created_by_id")

  @@index([sucursalId, fecha])
  @@index([opNumber])
  @@index([monto])
  @@index([estadoActual])
}

// Gastos operativos (feed /api/egresos). Shape plano, rubro {id,nombre}
// (finiquitos, honorarios, arriendos, proveedores, impuestos...). Aislado del
// motor de consolidados; por ahora es vista. Distinto de los egresos de
// dynatech (tipoOperacion=EGRESO, transferencias bancarias) — IDs disjuntos.
model EgresoMovement {
  id             String   @id @default(uuid())
  externalId     BigInt   @unique @map("external_id")     // r.id

  sucursalId     Int      @map("sucursal_id")
  sucursalName   String?  @map("sucursal_name")
  cajeroUsername String?  @map("cajero_username")
  cajeroName     String?  @map("cajero_name")

  glosa          String   @db.Text
  monto          BigInt                                     // negativo (gasto)
  rubroId        Int?     @map("rubro_id")
  rubroNombre    String?  @map("rubro_nombre")

  fecha          DateTime
  fechaCarga     DateTime? @map("fecha_carga")
  rawJson        Json     @map("raw_json")
  syncedAt       DateTime @default(now()) @map("synced_at")

  conciliacion   EgresoConciliacion?

  @@index([sucursalId, fecha])
  @@index([rubroId])
  @@index([fecha])
}

// Conciliación de un egreso operativo (EgresoMovement) contra movimiento(s) de
// banco OUT a terceros. Espejo de Consolidado/ConsolidadoLink pero del lado
// egresos. status: AUTO_MATCHED | SUGGESTED | MANUAL | NO_MATCH.
model EgresoConciliacion {
  id               String   @id @default(uuid())
  egresoMovementId String   @unique @map("egreso_movement_id")
  egresoMovement   EgresoMovement @relation(fields: [egresoMovementId], references: [id], onDelete: Cascade)

  status     String
  matchType  String?  @map("match_type")
  score      Int?
  // bankMovementIds propuestos por el motor en SUGGESTED (no vinculados).
  proposalJson Json?  @map("proposal_json")
  notes      String?  @db.Text

  matchedAt DateTime @default(now()) @map("matched_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links EgresoConciliacionLink[]

  @@index([status])
}

model EgresoConciliacionLink {
  id             String @id @default(uuid())
  conciliacionId String @map("conciliacion_id")
  conciliacion   EgresoConciliacion @relation(fields: [conciliacionId], references: [id], onDelete: Cascade)
  bankMovementId String @map("bank_movement_id")
  bankMovement   BankMovement @relation(fields: [bankMovementId], references: [id], onDelete: Cascade)

  @@unique([conciliacionId, bankMovementId])
  @@index([bankMovementId])
}

// ====================== Asientos manuales (sin contraparte) ======================
//
// Movimientos de cartola que NO tienen contraparte en el sistema (no vienen de
// Dynatech). El operador genera un asiento contable a mano desde la tab
// "Asientos manuales" de Consolidados. Dos tipos:
//   - PROVEEDOR: el pago (neto del banco) + retención de honorarios opcional
//     forman el BRUTO, que se reparte (DEBE) por sucursal según headcount.
//       DEBE  = Σ líneas por sucursal  = montoBruto
//       HABER = banco (montoNeto) + retención (montoRetencion → rubro retención)
//   - CLIENTE: por ahora solo queda PENDIENTE (sin reparto).
// Generar el asiento marca el BankMovement como resuelto (sale de la brecha).

// Maestro de sucursales para el prorrateo (centro de costo). headcount = Nº de
// personas, puede ser fraccionado (ej. 1.5). Editable en Configuración. `codigo`
// es el sucursalId que ya trae Dynatech (207, 202…); null para las sin código.
model Sucursal {
  id        String   @id @default(uuid())
  codigo    Int?     @unique
  nombre    String
  headcount Decimal  @default(0) @db.Decimal(6, 2)
  active    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lineas AsientoManualLinea[]

  @@index([active])
}

model AsientoManual {
  id             String       @id @default(uuid())
  bankMovementId String       @unique @map("bank_movement_id")
  bankMovement   BankMovement @relation(fields: [bankMovementId], references: [id], onDelete: Cascade)

  tipo   String // PROVEEDOR | CLIENTE
  estado String @default("GENERADO") // GENERADO | PENDIENTE (cliente)

  // Montos en CLP. montoNeto = monto del banco (HABER banco). montoBruto =
  // neto + retención = total del DEBE (lo repartido por sucursal).
  montoNeto      BigInt   @map("monto_neto")
  retencionTasa  Decimal? @map("retencion_tasa") @db.Decimal(7, 4) // % aplicado (snapshot)
  montoRetencion BigInt   @default(0) @map("monto_retencion") // HABER retención
  retencionRubro Int?     @map("retencion_rubro")
  montoBruto     BigInt   @map("monto_bruto")

  glosa String? @db.Text
  notas String? @db.Text

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lineas AsientoManualLinea[]

  @@index([tipo])
  @@index([estado])
}

model AsientoManualLinea {
  id        String        @id @default(uuid())
  asientoId String        @map("asiento_id")
  asiento   AsientoManual @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  sucursalId String       @map("sucursal_id")
  sucursal   Sucursal     @relation(fields: [sucursalId], references: [id])

  // Snapshot al momento del asiento (la config puede cambiar después).
  sucursalNombre String  @map("sucursal_nombre")
  personas       Decimal @db.Decimal(6, 2)
  porcentaje     Decimal @db.Decimal(7, 4) // ej. 14.0400
  monto          BigInt // DEBE de esta sucursal

  @@index([asientoId])
  @@index([sucursalId])
}

// Settings del módulo (un único row): tasa de retención de honorarios vigente
// (editable, varía por año) y rubro destino de la retención (default 26).
model AsientoManualSettings {
  id             String   @id @default("default")
  retencionTasa  Decimal  @default(0) @map("retencion_tasa") @db.Decimal(7, 4)
  retencionRubro Int      @default(26) @map("retencion_rubro")
  updatedAt      DateTime @updatedAt @map("updated_at")
}

// ===========================================================================
// Cuadratura Transbank (subtab "Conciliados (asiento)" de Cruce Transbank).
//
// Por cada sucursal se suman los movimientos CUADRADOS (POS/Dynatech ↔
// settlement Transbank) y se arma un asiento de partida doble:
//   HABER rubro 17  (ventas)     = Σ monto Dynatech (bruto POS)
//   DEBE  rubro 200 (Tesorería)  = Σ total abono Transbank (neto)
//   DEBE  rubro 708 (comisión)   = Σ comisión + IVA comisión
//   DEBE  rubro 1403 (diferencia)= Σ Dynatech − Σ Transbank − Σ comisión  (tapón
//                                  que cuadra el asiento; va al haber si es < 0)
//
// Generar una cuadratura PERSISTE los pares consumidos para que no se vuelvan a
// considerar en la siguiente corrida (semanal, re-ejecutable). Ver memoria.
// ===========================================================================

model CuadraturaTransbank {
  id    String   @id @default(uuid())
  desde DateTime
  hasta DateTime
  glosa String?  @db.Text

  // Snapshot de los rubros usados (la config puede cambiar después).
  rubroVentas     Int @map("rubro_ventas")
  rubroTesoreria  Int @map("rubro_tesoreria")
  rubroComision   Int @map("rubro_comision")
  rubroDiferencia Int @map("rubro_diferencia")

  // Totales snapshot (CLP).
  totalDynatech   BigInt @default(0) @map("total_dynatech")
  totalTransbank  BigInt @default(0) @map("total_transbank")
  totalComision   BigInt @default(0) @map("total_comision")
  totalDiferencia BigInt @default(0) @map("total_diferencia")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  items CuadraturaTransbankItem[]

  @@index([createdAt])
}

// Un par POS↔settlement consumido por una cuadratura. La unicidad de cada lado
// es lo que evita re-considerarlo. Sin FK a TbkTesoreria/TransbankSale a
// propósito: el sync/import puede recrear filas; el filtrado es por id presente.
model CuadraturaTransbankItem {
  id           String              @id @default(uuid())
  cuadraturaId String              @map("cuadratura_id")
  cuadratura   CuadraturaTransbank @relation(fields: [cuadraturaId], references: [id], onDelete: Cascade)

  tbkTesoreriaId  String @unique @map("tbk_tesoreria_id")
  transbankSaleId String @unique @map("transbank_sale_id")

  sucursalId     Int     @map("sucursal_id")
  sucursalName   String? @map("sucursal_name")
  sucursalCodigo Int?    @map("sucursal_codigo")

  // Snapshot del detalle por movimiento (para el desglose auditable).
  fecha     DateTime? @map("fecha")
  opBoleta  String?   @map("op_boleta")  // OP del POS / N° boleta del settlement
  medioPago String?   @map("medio_pago") // Débito/Crédito/Prepago

  montoDynatech     BigInt  @map("monto_dynatech")      // bruto POS
  montoTransbank    BigInt  @map("monto_transbank")     // total abono (neto)
  montoComision     BigInt  @map("monto_comision")      // comisión cartola (comision + IVA) → 1403
  montoComisionApi  BigInt  @default(0) @map("monto_comision_api") // comisión Dynatech (con IVA) → 708

  @@index([cuadraturaId])
  @@index([sucursalId])
}

// Vínculo MANUAL POS↔settlement en Cruce Transbank: para pares que el motor no
// puede cuadrar solo (sin llave común, monto no exacto, "ENVIO APP" con TCKT en
// vez de boleta, etc.). El matching los fuerza como cuadrados antes de las
// pasadas automáticas. Unicidad por lado: cada uno se vincula a lo sumo una vez.
model CruceTransbankLink {
  id              String   @id @default(uuid())
  tbkTesoreriaId  String   @unique @map("tbk_tesoreria_id")
  transbankSaleId String   @unique @map("transbank_sale_id")
  nota            String?  @db.Text
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
}

// Settings de un row: los 4 rubros del asiento de cuadratura (editables).
model CuadraturaTransbankSettings {
  id              String   @id @default("default")
  rubroVentas     Int      @default(17) @map("rubro_ventas")
  rubroTesoreria  Int      @default(200) @map("rubro_tesoreria")
  rubroComision   Int      @default(708) @map("rubro_comision")
  rubroDiferencia Int      @default(1403) @map("rubro_diferencia")
  updatedAt       DateTime @updatedAt @map("updated_at")
}

// Papelera de la cuadratura: pares cuadrados que el usuario APARTA para que NO
// entren al asiento (no cuadran, etc.). Mientras el registro exista, el par
// queda fuera de "por cuadrar". `expiresAt` = ventana para restaurar si fue por
// error; pasado el plazo el apartado es definitivo (sigue excluido, ya no se
// puede restaurar). No hay job: la exclusión la da la sola existencia del row.
model CuadraturaTransbankApartado {
  id String @id @default(uuid())

  tbkTesoreriaId  String @unique @map("tbk_tesoreria_id")
  transbankSaleId String @unique @map("transbank_sale_id")

  sucursalId     Int     @map("sucursal_id")
  sucursalName   String? @map("sucursal_name")
  sucursalCodigo Int?    @map("sucursal_codigo")

  fecha     DateTime? @map("fecha")
  opBoleta  String?   @map("op_boleta")
  medioPago String?   @map("medio_pago")

  montoDynatech  BigInt @map("monto_dynatech")
  montoTransbank BigInt @map("monto_transbank")
  montoComision  BigInt @map("monto_comision")

  motivo      String?  @db.Text
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
}
